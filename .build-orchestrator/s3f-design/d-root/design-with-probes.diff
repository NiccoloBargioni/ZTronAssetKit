+        case .dropAOnly:
+            v3 = [q] + fillers(841_000) + [k]
+        case .dropAKeepB:
+            v3 = [q] + fillers(841_000) + [b, k]
+        }
+        await harness.serveManifest(v3, etag: "v3")
+        let sync = Task { await engine.sync(.force) }
