+    /// PROTOTYPE (verifier, cycle 7): the transfers the copy lists a job's moved ids at (the jobs its follow joins).
+    private func movedTargets(of job: Job) -> [TransferID] {
+        guard self.holdsMovedID(job) else {
+            return []
         }
+        return job.assets.compactMap { self.state.applied.entry(for: $0)?.transferID }.filter { $0 != job.transfer }
     }
 
+    /// PROTOTYPE (verifier, cycle 7): a parked job a follow joined (its rank may have fallen: its lane rose) is judged at
+    /// its place after the follow; its earlier place in the sorted candidates is skipped.
+    private func rePlaceTargets(_ targets: [TransferID], sweep: SpaceSweep, into demoted: inout [(rank: Int, ticket: UInt64, transfer: TransferID)], rePlaced: inout Set<TransferID>) {
+        for target in targets {
+            guard let job = self.state.jobs[target], case .blocked(let reason) = job.state, reason == .insufficientSpace || (reason == .awaitingSpace && sweep != .read) else {
+                continue
+            }
+            let rank = self.queueRank(job)
+            let index = demoted.firstIndex { ($0.rank, $0.ticket) > (rank, job.ticket) } ?? demoted.count
+            demoted.insert((rank: rank, ticket: job.ticket, transfer: target), at: index)
+            rePlaced.insert(target)
+        }
+    }
+
+    /// PROTOTYPE (verifier, cycle 7): a followed job whose rank rose (its lane fell) is judged at its new place.
+    private func demoteSwept(_ job: Job, below rank: Int, into demoted: inout [(rank: Int, ticket: UInt64, transfer: TransferID)]) -> Bool {
+        let newRank = self.queueRank(job)
+        guard newRank > rank else {
+            return false
+        }
+        let index = demoted.firstIndex { ($0.rank, $0.ticket) > (newRank, job.ticket) } ?? demoted.count
+        demoted.insert((rank: newRank, ticket: job.ticket, transfer: job.transfer), at: index)
+        return true
+    }
